#!/usr/bin/env bash
# Fake codex exec: honours -C and --output-last-message.
WORKER=codex
last=""
while [ $# -gt 0 ]; do
  case "$1" in
    -C) cd "$2"; shift ;;
    --output-last-message) last="$2"; shift ;;
  esac
  shift
done
# Like codex exec --json: events on stdout, tokens only (2000 in incl. 500 cached, 300 out).
agent_reply() {
  printf '%s' "$1" > "$last"
  echo '{"type":"turn.completed","usage":{"input_tokens":2000,"cached_input_tokens":500,"output_tokens":300}}'
}
source "$(dirname "$0")/_agent.sh"
