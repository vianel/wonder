{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wonder worker contract v1 (build and fix stations)",
  "type": "object",
  "required": ["status", "summary", "files_changed", "notes"],
  "properties": {
    "status": {"enum": ["done", "blocked", "failed"]},
    "summary": {"type": "string"},
    "files_changed": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "string"}
  }
}
